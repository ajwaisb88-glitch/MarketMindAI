{
  "name": "marketmind-desktop",
  "version": "0.2.0",
  "description": "MarketMind AI - Electron + React desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "ui:build": "vite build",
    "backend:build": "node ./scripts/package-backend.js",
    "postinstall": "node ./scripts/postinstall-electron.js",
    "build": "npm run ui:build && npm run backend:build && electron-builder",
    "build:win": "npm run ui:build && npm run backend:build && electron-builder --win",
    "build:mac": "npm run ui:build && npm run backend:build && electron-builder --mac",
    "build:linux": "npm run ui:build && npm run backend:build && electron-builder --linux",
    "verify:package": "node ./scripts/verify-packaged-build.js"
  },
  "keywords": [
    "marketmind",
    "electron",
    "react"
  ],
  "author": "MarketMind AI",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "electron@43.1.0": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "ai.marketmind.desktop",
    "productName": "MarketMind AI",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**",
      "scripts/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "ajwaisb88-glitch",
      "repo": "MarketMindAI"
    }
  }
}
